{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/grocery/:path*",
      "destination": "/api/grocery.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/Task_05_React_basics/02_Task_Counter/dist/:path*",
      "destination": "/Task_05_React_basics/02_Task_Counter/dist/index.html"
    },
    {
      "source": "/Task_06_Travel_Tour_App/dist/:path*",
      "destination": "/Task_06_Travel_Tour_App/dist/index.html"
    },
    {
      "source": "/Task_07_React_hooks_project_pack/01_Mini-projects/dist/:path*",
      "destination": "/Task_07_React_hooks_project_pack/01_Mini-projects/dist/index.html"
    },
    {
      "source": "/Task_07_React_hooks_project_pack/02_Food_Receipe_App/dist/:path*",
      "destination": "/Task_07_React_hooks_project_pack/02_Food_Receipe_App/dist/index.html"
    },
    {
      "source": "/Task_10_MERN_CRUD_integration/client/dist/:path*",
      "destination": "/Task_10_MERN_CRUD_integration/client/dist/index.html"
    },
    {
      "source": "/Task_11_MERN_Auth_CRUD/client/dist/:path*",
      "destination": "/Task_11_MERN_Auth_CRUD/client/dist/index.html"
    },
    {
      "source": "/Task_12_MERN_Grocery_App/client/dist/:path*",
      "destination": "/Task_12_MERN_Grocery_App/client/dist/index.html"
    }
  ]
}
